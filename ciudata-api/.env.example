# ── Base de datos ─────────────────────────────────────────────────────────
#
# Supabase (recomendado para el piloto):
#   Obtener en: Supabase → Project Settings → Database → Connection string → URI
#   Usar la conexión DIRECTA (puerto 5432), no el pooler, para soportar transacciones.
#
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres
#
# Docker local (desarrollo):
# DATABASE_URL=postgresql://ciudata:ciudata123@localhost:5432/ciudata_db
#
# Forzar SSL manualmente (auto-detectado si la URL contiene "supabase"):
# DB_SSL=true

# ── Redis (caché de ranking provisional, TTL 1 h) ─────────────────────────
# Upstash Redis (gratuito, compatible con Supabase deployments):
#   Obtener en: upstash.com → Create Database → REST → REDIS_URL
REDIS_URL=redis://localhost:6379
RANKING_CACHE_TTL=3600

# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT autenticación ciudadana ───────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_en_produccion
JWT_TTL=7d

# ── OTP por SMS (Twilio) — vacío = modo consola en desarrollo ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ── Firebase Cloud Messaging ──────────────────────────────────────────────
# Pegar el JSON completo del service account de Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── IoT Domos — webhook secret ────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOMO_WEBHOOK_SECRET=cambia_esto_en_produccion

# ── Administración interna ────────────────────────────────────────────────
ADMIN_KEY=cambia_esto_en_produccion
